# =============================================================
# CARLA RL Project — .gitignore
# =============================================================

# Runtime results (regenerated by running experiments)
results/logs/
results/checkpoints/
results/plots/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments
venv/
env/
.env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Downloaded wheels (large binaries, not project source)
*.whl
sb3_wheels/

# Keep results folder structure but not contents
!results/.gitkeep
!results/logs/.gitkeep
!results/checkpoints/.gitkeep
!results/plots/.gitkeep